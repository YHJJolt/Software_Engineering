<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="AdminMaster.master.cs" Inherits="SchoolSystem.AdminMaster" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <meta charset="utf-8" />
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="~/Admin/Admin.css?v=2" />
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true" />

        <div id="sidebar"> 
            <div class="sidebar-header">
                <span class="header-text">ADMIN PANEL</span>
                <i class="fas fa-bars" id="toggle-btn" onclick="toggleSidebar()"></i>
            </div>
            <div class="nav-container">
                <a id="linkDashboard" runat="server" href="~/Admin/AdminDashboard.aspx" class="nav-link"><i class="fas fa-th-large"></i> <span>Dashboard</span></a>
                <a id="linkPrograms" runat="server" href="~/Admin/Program.aspx" class="nav-link"><i class="fas fa-graduation-cap"></i> <span>Program Management</span></a>
                <a id="linkUsers" runat="server" href="~/Admin/UserManagement.aspx" class="nav-link"><i class="fas fa-users"></i> <span>User Management</span></a>
                <a id="linkPayment" runat="server" href="~/Admin/ManagePayments.aspx" class="nav-link"><i class="fas fa-credit-card"></i> <span>Payment</span></a>
                <a id="linkCourses" runat="server" href="~/Admin/Courses.aspx" class="nav-link"><i class="fas fa-book"></i> <span>Course Management</span></a>
                <a id="linkCourseAllocation" runat="server" href="~/Admin/CourseAllocation.aspx" class="nav-link"><i class="fas fa-receipt"></i> <span>Course Allocation</span></a>
                <a id="linkEnrollment" runat="server" href="~/Admin/Enrollment.aspx" class="nav-link"><i class="fas fa-user-plus"></i> <span>Enrollment</span></a>
                <a id="linkPerformance" runat="server" href="~/Admin/Performance.aspx" class="nav-link"><i class="fas fa-chart-line"></i> <span>Performance</span></a>
                <a id="linkAnnouncements" runat="server" href="~/Admin/AdminAnnouncement.aspx" class="nav-link"><i class="fas fa-bullhorn"></i> <span>Announcement</span></a>
                <a id="linkCalendar" runat="server" href="~/Admin/Calendar.aspx" class="nav-link"><i class="fas fa-calendar-alt"></i> <span>Calendar</span></a>
            </div>
            <a runat="server" href="~/Admin/AdminProfile.aspx" class="sidebar-profile">
                <asp:Image ID="imgSidebar" runat="server" CssClass="p-img" ImageUrl="~/Images/default-avatar.png" />
                <div class="p-text">
                    <span class="p-name"><asp:Literal ID="litSidebarName" runat="server" /></span>
                </div>
            </a>
        </div>
        <div id="admin-topbar">
            <%-- NOTIFICATION BELL --%>
            <div class="notif-container">
                <div class="notif-bell-wrapper" onclick="toggleNotifs(event)">
                    <i class="fas fa-bell notif-bell"></i>
                    <asp:Literal ID="litNotifCount" runat="server"></asp:Literal>
                </div>

                <div id="notifDropdown" class="notif-dropdown" style="display:none;">
                    <div class="notif-header">
                        <h4>Notifications</h4>
                        <asp:UpdatePanel ID="updMarkRead" runat="server" UpdateMode="Conditional">
                            <ContentTemplate>
                                <asp:LinkButton ID="btnMarkRead" runat="server"
                                    CssClass="mark-read-btn"
                                    OnClick="btnMarkRead_Click"
                                    OnClientClick="handleMarkRead();">
                                    Mark all as read
                                </asp:LinkButton>
                            </ContentTemplate>
                        </asp:UpdatePanel>
                    </div>

                    <div class="notif-body">
                        <asp:PlaceHolder ID="noNotifs" runat="server" Visible="false">
                            <div class="no-notifs">
                                <i class="fas fa-bell-slash"></i>
                                <p>No upcoming events!</p>
                            </div>
                        </asp:PlaceHolder>

                        <asp:Repeater ID="rptNotifications" runat="server">
                            <ItemTemplate>
                                <a href='<%# Eval("Link") != DBNull.Value ? ResolveUrl(Eval("Link").ToString()) : "#" %>'
                                   class='notif-item <%# Convert.ToInt32(Eval("IsUnread")) == 1 ? "unread" : "" %>'>
                                    <div class="notif-icon-wrapper">
                                        <i class="fas fa-clock"></i>
                                    </div>
                                    <div class="notif-content">
                                        <span class="notif-msg"><%# Eval("Message") %></span>
                                        <span class="notif-time"><%# Eval("TimeAgo") %></span>
                                    </div>
                                </a>
                            </ItemTemplate>
                        </asp:Repeater>
                    </div>
                </div>
            </div>
        </div>

        <div id="main-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>
    <script>
        function toggleSidebar() {
            document.body.classList.toggle('sidebar-collapsed');
            localStorage.setItem('sidebarState', document.body.classList.contains('sidebar-collapsed') ? 'collapsed' : 'expanded');
        }
        window.onload = function () {
            if (localStorage.getItem('sidebarState') === 'collapsed') document.body.classList.add('sidebar-collapsed');
        };

        function toggleNotifs(event) {
            if (event) event.stopPropagation();
            var dropdown = document.getElementById('notifDropdown');
            var isOpening = dropdown.style.display !== 'block';
            dropdown.style.display = isOpening ? 'block' : 'none';
            if (isOpening) {
                zeroOutBadge();
                var btn = document.getElementById('<%= btnMarkRead.ClientID %>');
                if (btn) btn.click();
            }
        }

        function zeroOutBadge() {
            var badge = document.querySelector('.notif-badge');
            if (badge) badge.style.display = 'none';

            document.querySelectorAll('.notif-item.unread').forEach(function (el) {
                el.classList.remove('unread');
            });
        }

        function handleMarkRead() {
            event.stopPropagation();
            zeroOutBadge();
        }

        document.getElementById('notifDropdown').addEventListener('click', function (e) {
            e.stopPropagation();
        });

        document.addEventListener('click', function (event) {
            var container = document.querySelector('.notif-container');
            if (container && !container.contains(event.target)) {
                var dd = document.getElementById('notifDropdown');
                if (dd) dd.style.display = 'none';
            }
        });
    </script>
</body>
</html>