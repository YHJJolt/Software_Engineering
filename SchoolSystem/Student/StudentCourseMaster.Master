<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="StudentCourseMaster.master.cs" Inherits="SchoolSystem.StudentCourseMaster" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <meta charset="utf-8" />
    <title>Course Portal - Student</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    
    <link href="~/Student/Student.css" rel="stylesheet" runat="server" />
    
    <style>
        .back-btn { background-color: rgba(18, 20, 32, 0.05); margin-bottom: 15px; border-bottom: 1px solid rgba(0,0,0,0.1); }
        .back-btn i { color: var(--navy-accent) !important; }
        .back-btn:hover { background-color: rgba(239, 68, 68, 0.1) !important; color: #ef4444 !important; }
        .back-btn:hover i { color: #ef4444 !important; }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true" />
        <asp:ScriptManagerProxy runat="server" />
        
        <div id="sidebar">
            <div class="sidebar-header">
                <i class="fas fa-book-open icon"></i>
                <span style="font-size: 18px;"><asp:Literal ID="litCourseCode" runat="server">Course</asp:Literal></span>
            </div>
            
            <div class="nav-links">
                <a runat="server" href="~/Student/StudentDashboard.aspx" class="nav-link back-btn"><i class="fas fa-arrow-left"></i> <span>Back to Dashboard</span></a>
                <a id="linkHome" runat="server" href="~/Student/StudentCourseHome.aspx" class="nav-link"><i class="fas fa-home"></i> <span>Home</span></a>
                <a id="linkPeople" runat="server" href="~/Student/StudentCoursePeople.aspx" class="nav-link"><i class="fas fa-users"></i> <span>People</span></a>
                <a id="linkModules" runat="server" href="~/Student/StudentCourseModules.aspx" class="nav-link"><i class="fas fa-layer-group"></i> <span>Modules</span></a>
                <a id="linkAssignments" runat="server" href="~/Student/StudentCourseAssignments" class="nav-link"><i class="fas fa-file-alt"></i> <span>Assignments</span></a>
                <a id="linkGrades" runat="server" href="~/Student/StudentIndivGrades.aspx" class="nav-link"><i class="fas fa-star"></i> <span>Grades</span></a>
                <a id="linkAnnouncements" runat="server" href="~/Student/StudentAnnouncements.aspx" class="nav-link"><i class="fas fa-bullhorn"></i> <span>View Announcements</span></a>
            </div>
            
            <a id="linkSidebarProfile" runat="server" href="~/Student/StudentProfile.aspx" class="sidebar-profile">
                <asp:Image ID="imgSidebar" runat="server" CssClass="p-img" ImageUrl="~/Images/default-avatar.png" />
                <div class="p-text">
                    <span class="p-name"><asp:Literal ID="litSidebarName" runat="server" /></span>
                </div>
            </a>
        </div>

        <div id="main-wrapper">
            <div id="topbar">
                <div class="topbar-left">
                    <button type="button" class="menu-toggle" onclick="toggleSidebar()">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h2 class="page-title"><asp:Literal ID="litPageTitle" runat="server">Course Screen</asp:Literal></h2>
                </div>
              
                <%-- NOTIFICATION BELL (FULLY REPLICATED FROM STUDENTMASTER) --%>
                <div class="notif-container">
                    <div class="notif-bell-wrapper" onclick="toggleNotifs(event)">
                        <i class="fas fa-bell notif-bell"></i>
                        <asp:Literal ID="litNotifCount" runat="server"></asp:Literal>
                    </div>

                    <div id="notifDropdown" class="notif-dropdown" style="display:none;">
                        <div class="notif-header">
                            <h4>Notifications</h4>
                            <asp:UpdatePanel ID="updMarkRead" runat="server" UpdateMode="Conditional">
                                <ContentTemplate>
                                    <asp:LinkButton ID="btnMarkRead" runat="server"
                                        CssClass="mark-read-btn"
                                        OnClick="btnMarkRead_Click"
                                        OnClientClick="handleMarkRead();">
                                        Mark all as read
                                    </asp:LinkButton>
                                </ContentTemplate>
                            </asp:UpdatePanel>
                        </div>

                        <div class="notif-body">
                            <asp:PlaceHolder ID="noNotifs" runat="server" Visible="false">
                                <div class="no-notifs">
                                    <i class="fas fa-bell-slash"></i>
                                    <p>You're all caught up!</p>
                                </div>
                            </asp:PlaceHolder>

                            <asp:Repeater ID="rptNotifications" runat="server">
                                <ItemTemplate>
                                    <a href='<%# Eval("Link") != DBNull.Value ? ResolveUrl(Eval("Link").ToString().Replace("StudentGrades.aspx", "StudentIndGrades.aspx")) : "#" %>' 
                                       class='notif-item <%# Convert.ToInt32(Eval("IsUnread")) == 1 ? "unread" : "" %>'>
                                        <div class="notif-icon-wrapper">
                                            <i class="fas fa-bell"></i>
                                        </div>
                                        <div class="notif-content">
                                            <span class="notif-msg"><%# Eval("Message") %></span>
                                            <span class="notif-time"><%# Eval("TimeAgo") %></span>
                                        </div>
                                    </a>
                                </ItemTemplate>
                            </asp:Repeater>
                        </div>
                    </div>
                </div>
            </div>

            <div id="main-content">
                <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
            </div>
        </div>
    </form>

    <script>
        function toggleSidebar() {
            document.body.classList.toggle('sidebar-collapsed');
            localStorage.setItem('sidebarState', document.body.classList.contains('sidebar-collapsed') ? 'collapsed' : 'expanded');
        }
        window.onload = function () {
            if (localStorage.getItem('sidebarState') === 'collapsed') {
                document.body.classList.add('sidebar-collapsed');
            }
        }

        // EXACT STUDENTMASTER JS REPLICATION
        function toggleNotifs(event) {
            if (event) event.stopPropagation();
            var dropdown = document.getElementById('notifDropdown');
            var isOpening = dropdown.style.display !== 'block';
            dropdown.style.display = isOpening ? 'block' : 'none';
            if (isOpening) {
                zeroOutBadge();
                var btn = document.getElementById('<%= btnMarkRead.ClientID %>');
                if (btn) btn.click();
            }
        }

        function zeroOutBadge() {
            var badge = document.querySelector('.notif-badge');
            if (badge) badge.style.display = 'none';

            document.querySelectorAll('.notif-item.unread').forEach(function (el) {
                el.classList.remove('unread');
            });
        }

        function handleMarkRead() {
            event.stopPropagation();
            zeroOutBadge();
        }

        document.getElementById('notifDropdown').addEventListener('click', function (e) {
            e.stopPropagation();
        });

        document.addEventListener('click', function (event) {
            var container = document.querySelector('.notif-container');
            if (container && !container.contains(event.target)) {
                var dd = document.getElementById('notifDropdown');
                if (dd) dd.style.display = 'none';
            }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>